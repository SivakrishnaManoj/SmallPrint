{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smallprint.dev/schemas/request",
  "title": "AnalyseRequest",
  "description": "Body POSTed by the extension to /analyse",
  "type": "object",
  "required": ["item", "purchase_type_signals", "links", "page_text_snippets", "price_drift", "install_id"],
  "additionalProperties": false,
  "properties": {
    "item": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "name":   { "type": ["string", "null"] },
        "brand":  { "type": ["string", "null"] },
        "price":  { "type": ["number", "null"] },
        "seller": { "type": ["string", "null"] },
        "url":    { "type": "string", "format": "uri" },
        "id":     { "type": ["string", "null"] }
      }
    },
    "purchase_type_signals": {
      "type": "array",
      "items": { "type": "string", "enum": ["product", "subscription", "contract"] }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "text", "kind"],
        "additionalProperties": false,
        "properties": {
          "url":  { "type": "string", "format": "uri" },
          "text": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["terms", "returns", "warranty", "cancel", "subscription", "contract_summary", "price_guide", "privacy", "other"]
          }
        }
      }
    },
    "page_text_snippets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "price_drift": {
      "type": "object",
      "required": ["first_seen", "current"],
      "additionalProperties": false,
      "properties": {
        "first_seen": { "type": ["number", "null"] },
        "current":    { "type": ["number", "null"] }
      }
    },
    "terms": {
      "description": "T&C pages and PDFs fetched by the extension from the user's browser. Optional: omit it, or send an entry with fetch_status 'failed', and the backend falls back to search and labels the card.",
      "type": "array",
      "items": { "$ref": "#/$defs/terms_document" },
      "default": []
    },
    "install_id": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "terms_document": {
      "type": "object",
      "required": ["url", "fetch_status"],
      "additionalProperties": false,
      "properties": {
        "url":  { "type": "string", "format": "uri" },
        "kind": {
          "type": "string",
          "enum": ["terms", "returns", "warranty", "cancel", "subscription", "contract_summary", "price_guide", "privacy", "other"]
        },
        "fetch_status": { "type": "string", "enum": ["ok", "failed"] },
        "content_type": { "type": "string", "enum": ["text", "pdf"] },
        "text":         { "type": "string", "maxLength": 500000 },
        "pdf_base64":   { "type": "string", "maxLength": 20000000 },
        "error":        { "type": ["string", "null"], "description": "Why the fetch failed, for display and logs." }
      },
      "allOf": [
        {
          "if":   { "properties": { "fetch_status": { "const": "ok" } }, "required": ["fetch_status"] },
          "then": { "required": ["content_type"] }
        },
        {
          "if":   { "properties": { "content_type": { "const": "text" } }, "required": ["content_type"] },
          "then": { "required": ["text"] }
        },
        {
          "if":   { "properties": { "content_type": { "const": "pdf" } }, "required": ["content_type"] },
          "then": { "required": ["pdf_base64"] }
        }
      ]
    }
  }
}
