{
  "name": "smallprint-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build -c vite.content.config.ts",
    "watch": "vite build --watch & vite build -c vite.content.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "test40": "npm run build && node ../demo/run40.mjs"
  },
  "dependencies": {
    "preact": "^10.25.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.1",
    "@testing-library/preact": "^3.2.6",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.5",
    "happy-dom": "^15.11.7",
    "linkedom": "^0.18.15",
    "playwright": "^1.65.0",
    "typescript": "~5.6.0",
    "vite": "^6.3.0",
    "vitest": "^3.0.0"
  }
}
