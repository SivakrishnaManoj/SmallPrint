{
  "manifest_version": 3,
  "name": "SmallPrint",
  "description": "Shows the real cost, lock-in and small print of what you're about to buy.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "SmallPrint: no purchase detected on this page",
    "default_icon": {
      "16": "icons/grey-16.png",
      "32": "icons/grey-32.png",
      "48": "icons/grey-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.ngrok-free.app/*",
    "https://*.up.railway.app/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/color-16.png",
    "32": "icons/color-32.png",
    "48": "icons/color-48.png",
    "128": "icons/color-128.png"
  }
}
